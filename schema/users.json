{
  "name": "users",
  "label": "Users",
  "plural": "users",
  "singular": "user",
  "primaryKey": "id",
  "fields": [
    {
      "name": "id",
      "type": "number",
      "autoIncrement": true,
      "required": true
    },
    {
      "name": "name",
      "type": "text",
      "required": true
    },
    {
      "name": "email",
      "type": "email",
      "required": true
    },
    {
      "name": "role",
      "type": "enum",
      "required": true,
      "options": [
        { "value": "admin" },
        { "value": "user" },
        { "value": "manager" }
      ]
    },
    {
      "name": "phone",
      "type": "text"
    },
    {
      "name": "bio",
      "type": "textarea"
    },
    {
      "name": "status",
      "type": "enum",
      "defaultValue": "active",
      "options": [
        { "value": "active" },
        { "value": "inactive" },
        { "value": "pending" }
      ]
    },
    {
      "name": "avatar",
      "type": "url"
    },
    {
      "name": "password",
      "type": "password",
      "required": true
    }
  ],
  "timestamps": {
    "createdAt": "created_at",
    "updatedAt": "updated_at"
  }
}
