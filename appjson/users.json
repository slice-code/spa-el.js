{
  "path": "/users",
  "type": "crud",
  "config": {
    "resource": "users",
    "title": "User Management",
    "icon": "fas fa-users",
    "formDisplay": "modal",
    "modalSize": "large",
    "table": {
      "columns": [
        { "key": "id", "label": "ID", "sortable": true },
        { "key": "name", "label": "Name", "sortable": true, "searchable": true },
        { "key": "email", "label": "Email", "sortable": true },
        { "key": "role", "label": "Role" },
        {
          "key": "actions",
          "type": "actions",
          "actions": ["edit", "delete"]
        }
      ],
      "features": {
        "search": true,
        "pagination": true,
        "perPage": 10
      }
    },
    "form": {
      "columns": 2,
      "gap": "1rem",
      "fields": [
        { "name": "name", "label": "Full Name", "type": "text", "required": true, "placeholder": "Enter full name" },
        { "name": "email", "label": "Email Address", "type": "email", "required": true, "placeholder": "user@example.com" },
        { 
          "name": "role", 
          "label": "Role", 
          "type": "select", 
          "required": true,
          "options": [
            { "value": "admin", "label": "Administrator" },
            { "value": "user", "label": "Regular User" },
            { "value": "manager", "label": "Manager" }
          ]
        },
        { "name": "phone", "label": "Phone Number", "type": "text", "placeholder": "+62 xxx xxxx xxxx" },
        { 
          "name": "bio", 
          "label": "Bio", 
          "type": "textarea", 
          "rows": 4,
          "placeholder": "Tell us about yourself...",
          "colspan": 2
        }
      ],
      "layout": "vertical",
      "submitText": "Save User",
      "cancelText": "Cancel"
    }
  },
  "options": {
    "permissions": ["admin", "user"]
  }
}
